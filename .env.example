# Local SQLite storage. Keep data and uploads in backups; do not commit them.
DATABASE_PATH=./data/motion-drive.sqlite
APP_URL=http://localhost:3000
# No paid calls are enabled by default. Explicit owner approval required first.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_DAILY_BUDGET_USD=0
OPENAI_MONTHLY_BUDGET_USD=0
OPENAI_MAX_OUTPUT_TOKENS=350
# Verified USD per million tokens for selected model; unknown pricing disables AI.
OPENAI_INPUT_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0
