# Local SQLite storage. Keep data and uploads in backups; do not commit them.
DATABASE_PATH=./data/motion-drive.sqlite
APP_URL=http://localhost:3000
# No paid calls are enabled by default. Explicit owner approval required first.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_DAILY_BUDGET_USD=0
OPENAI_MONTHLY_BUDGET_USD=0
OPENAI_MAX_OUTPUT_TOKENS=350
# Verified USD per million tokens for selected model; unknown pricing disables AI.
OPENAI_INPUT_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0
# Production PostgreSQL: private schema, restricted server-only role, transaction pooler.
# Leave empty for local SQLite. Never use NEXT_PUBLIC_ for this connection.
DATABASE_URL=
# Private Vercel Blob store is automatically connected to the production project.
BLOB_STORE_ID=
# Legacy Blob deployments may receive BLOB_READ_WRITE_TOKEN from the integration.
# First administrator, created automatically on the first start with an EMPTY database.
# Set both in Vercel (Production), open the site once, then DELETE them. Password: 12+ characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# DATABASE_URL may also be provided as POSTGRES_URL (Vercel/Neon integrations set it).
